# Прод-образ (multi-stage, non-root, NODE_ENV=production) — отдельно от Dockerfile (dev,
# start:dev + volume-mounted src для hot reload). NODE_ENV раньше не задавался нигде в артефактах
# деплоя, хотя от него зависят Swagger/Secure-кука/SQL-логи (M1, round-2 review §5).

# ---- build ----
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY . .
RUN yarn build

# ---- runtime ----
FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production && yarn cache clean

COPY --from=build /app/dist ./dist

# uploads.constants.ts: UPLOADS_ROOT = process.cwd()/uploads = /app/uploads — процесс под USER node
# ниже должен иметь право туда писать (первая же загрузка медиа иначе падает EACCES, N-7, round-3
# review). chown -R по всему /app раздул бы образ новым слоем с копией production-node_modules —
# создаём и chown'им только сам каталог uploads, ничего больше не копируем поверх уже готовых слоёв.
# Если в проде uploads монтируется томом/bind-mount'ом с хоста — права ВНУТРИ образа не решают
# ничего, владелец берётся с хоста: каталог на хосте должен принадлежать uid 1000 (это отдельная
# операционная настройка деплоя, не часть образа).
RUN mkdir -p /app/uploads/media && chown -R node:node /app/uploads

# Образ node:22-alpine уже содержит непривилегированного пользователя "node" (uid 1000) — не root.
USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.APP_PORT||3000)+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "dist/main"]
