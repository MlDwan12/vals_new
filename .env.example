# -----------------------------
# APP
# -----------------------------
NODE_ENV=development
APP_PORT=3000

# -----------------------------
# DATABASE (PostgreSQL)
# -----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=vals_new
DB_PASS=
DB_NAME=vals_new_db

# -----------------------------
# LOGGER (nestjs-pino)
# LOG_LEVEL: fatal | error | warn | info | debug | trace
# -----------------------------
LOG_LEVEL=info
LOG_PRETTY=true

# -----------------------------
# CORS — список origin через запятую
# -----------------------------
CORS_ORIGINS=http://localhost:3001

# -----------------------------
# SWAGGER (/docs) — выключить в проде
# -----------------------------
ENABLE_SWAGGER=true
