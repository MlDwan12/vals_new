# -----------------------------
# APP
# NODE_ENV=production обязателен на боевом деплое — от него зависит Secure-флаг auth-кук
# (src/core/cookies/auth-cookies.ts) и дефолт ENABLE_SWAGGER. Ни Dockerfile, ни docker-compose.yml
# его не задают — задаётся только через .env.
# -----------------------------
NODE_ENV=development
APP_PORT=3000

# -----------------------------
# DATABASE (PostgreSQL)
# -----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=vals_new
DB_PASS=
DB_NAME=vals_new_db

# -----------------------------
# LOGGER (nestjs-pino)
# LOG_LEVEL: fatal | error | warn | info | debug | trace
# -----------------------------
LOG_LEVEL=info
LOG_PRETTY=true

# -----------------------------
# CORS — список origin через запятую
# -----------------------------
CORS_ORIGINS=http://localhost:3001

# -----------------------------
# SWAGGER (/docs) — без переменной дефолт зависит от NODE_ENV (true везде кроме production, чтобы
# забытая переменная не открыла /docs в проде). Раскомментируйте только чтобы явно переопределить.
# -----------------------------
# ENABLE_SWAGGER=true

# -----------------------------
# AUTH / JWT — секреты access/refresh должны различаться, не короче 32 символов
# -----------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# -----------------------------
# SEED — только для `yarn seed:developer`, рантайму приложения не нужны
# -----------------------------
SEED_DEVELOPER_USERNAME=
SEED_DEVELOPER_PASSWORD=

# -----------------------------
# BITRIX24 — webhook для приёма заявок (POST /bitrix), формат:
# https://<domain>.bitrix24.ru/rest/<user_id>/<webhook_code>/
# -----------------------------
BITRIX_WEBHOOK=

# -----------------------------
# MEILISEARCH — поиск (GET /search)
# MEILI_MASTER_KEY — придумываете сами (не короче 16 символов), тот же ключ прописывается
#   контейнеру meilisearch в docker-compose.yml (переменная MEILI_MASTER_KEY).
# MEILI_SEARCH_KEY — НЕ придумывается заранее: после первого запуска Meilisearch с мастер-ключом
#   получить `curl -H "Authorization: Bearer $MEILI_MASTER_KEY" http://localhost:7700/keys` и
#   взять значение "Default Search API Key" (только права search — без него нельзя, ТЗ §6).
# -----------------------------
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=
MEILI_SEARCH_KEY=

# -----------------------------
# ETL (yarn migrate:prod-data) — одноразово, этап 7, рантайму приложения не нужны.
# SOURCE_* — копия боевой БД старого vals_api, TARGET_* — эта (новая) БД. Порядок прогона:
# бэкап TARGET → migration:run (пустая схема) → migrate:prod-data → сид (если нужен).
# SOURCE_IMAGE_LIB_ROOT — путь к локально доступному uploads/image-lib/ старого прода (обычно
#   заранее синхронизированная копия, не сам SOURCE_DB_HOST) — файлы физически копируются в
#   uploads/media/ этого проекта.
# -----------------------------
SOURCE_DB_HOST=
SOURCE_DB_PORT=5432
SOURCE_DB_USER=
SOURCE_DB_PASS=
SOURCE_DB_NAME=
SOURCE_IMAGE_LIB_ROOT=

TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_USER=vals_new
TARGET_DB_PASS=
TARGET_DB_NAME=vals_new_db
